<h1>投稿を編集</h1>

<% if @post.errors.any? %>

  <div style="color:red;">

    <ul>

      <% @post.errors.full_messages.each do |message| %>

        <li><%= message %></li>

      <% end %>

    </ul>

  </div>

<% end %>

<%= form_with model: @post do |f| %>

  <div>

    <%= f.label :content, "内容" %><br>

    <%= f.text_area :content %>

  </div>

  <br>

  <%= f.submit "更新する" %>

<% end %>

<br>

<%= link_to "一覧へ戻る", posts_path %>