<h1>投稿一覧</h1>

<p>
  <%= link_to "新しい投稿", new_post_path %>
</p>

<% @posts.each do |post| %>
  <div style="border:1px solid gray; padding:10px; margin-bottom:10px;">
    <p><%= post.content %></p>

    <%= link_to "編集", edit_post_path(post) %>
    |
    <%= link_to "削除",
                post_path(post),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "本当に削除しますか？"
                } %>
  </div>
<% end %>